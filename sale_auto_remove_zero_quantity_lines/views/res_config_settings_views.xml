<?xml version="1.0" encoding="utf-8" ?>
<odoo>
 <record id="view_sale_config_settings_inherit" model="ir.ui.view">
      <field name="name">res.config.settings.view.inherit.sale</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">

                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="sale_auto_remove_zero_quantity_lines"
                >
                    <div class="o_setting_left_pane">
                        <field name="sale_auto_remove_zero_quantity_lines" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="sale_auto_remove_zero_quantity_lines" />
                        <div class="text-muted">
                            Elimina automáticamente las líneas de pedido de venta con cantidad cero al confirmar.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
