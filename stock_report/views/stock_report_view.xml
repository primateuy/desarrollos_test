<odoo>
    <!-- Vista tree -->
  <record id="view_report_stock_by_warehouse_tree" model="ir.ui.view">
    <field name="name">report.stock.by.warehouse.tree</field>
    <field name="model">report.stock.by.warehouse</field>
    <field name="arch" type="xml">
      <tree>
        <field name="product_id"/>
        <field name="warehouse_id"/>
        <field name="qty_available"/>
        <field name="virtual_available"/>
      </tree>
    </field>
  </record>
    <!-- Vista pivot -->
  <record id="view_report_stock_by_warehouse_pivot" model="ir.ui.view">
    <field name="name">report.stock.by.warehouse.pivot</field>
    <field name="model">report.stock.by.warehouse</field>
    <field name="arch" type="xml">
      <pivot string="Stock por Almacén">
        <field name="product_id" type="row"/>
        <field name="warehouse_id" type="col"/>
        <field name="qty_available" type="measure"/>
        <field name="virtual_available" type="measure"/>
        <field name="daily_consumption" type="measure"/>
        <field name="days_of_stock" type="measure"/>
      </pivot>
    </field>
  </record>

  <!-- Acción -->
  <record id="action_report_stock_by_warehouse" model="ir.actions.act_window">
    <field name="name">Stock por almacén</field>
    <field name="res_model">report.stock.by.warehouse</field>
    <field name="view_mode">tree,pivot</field>
    <field name="help" type="html">
      <p>Reporte de stock por producto y almacén con cantidades reales y pronosticadas</p>
    </field>
  </record>

  <!-- Menú -->
  <menuitem id="menu_stock_by_warehouse_root" name="Stock por almacén" parent="stock.menu_stock_inventory_control" sequence="99"/>
  <menuitem id="menu_stock_by_warehouse_report" name="Reporte de stock" action="action_report_stock_by_warehouse" parent="menu_stock_by_warehouse_root"/>
</odoo>